 "enemyRules": [
  {
   "id": "enemy-air",
   "label": "aircraft",
   "when": {
    "group": "vehicles",
    "field": "category",
    "matches": "air"
   },
   "weights": {
    "antiAir": 1.3
   },
   "because": "The anti-air launcher is the only payload on the specialization list that reaches an aircraft, so without one an enemy helicopter is something you can only hide from.",
   "see": "specializations"
  },
  {
   "id": "enemy-armoured-ground",
   "label": "an armoured ground vehicle",
   "when": {
    "group": "vehicles",
    "field": "armor",
    "matches": "armor"
   },
   "weights": {
    "antiVehicle": 1.2
   },
   "because": "Nothing in an ordinary loadout opens armour, and the armour rule says the piercing round is the one that keeps working as tiers climb.",
   "see": "armor-and-damage-reduction",
   "prefer": {
    "key": "ammo-types:ap",
    "weight": 1
   }
  },
  {
   "id": "enemy-ground",
   "label": "a ground vehicle",
   "when": {
    "group": "vehicles",
    "field": "category",
    "matches": "ground"
   },
   "weights": {
    "antiVehicle": 1
   },
   "because": "Without something that can hurt a vehicle, the answer to one arriving is to leave the ground you were holding.",
   "see": "specializations"
  },
  {
   "id": "enemy-long",
   "label": "a long-range weapon",
   "when": {
    "group": "weapons",
    "field": "category",
    "matches": "sniper|marksman"
   },
   "weights": {
    "magnification": 0.8,
    "longOptic": 0.6,
    "smoke": 0.9
   },
   "because": "You either match the magnification or you take the sightline away, and smoke is the item on this list that takes it away.",
   "see": "hot-zone"
  },
  {
   "id": "enemy-close",
   "label": "a close-range weapon",
   "when": {
    "group": "weapons",
    "field": "category",
    "matches": "smg|shotgun|pistol"
   },
   "weights": {
    "shortOptic": 0.8,
    "closeCategory": 0.7,
    "fullAuto": 0.5
   },
   "because": "Where that weapon is strong, the sight that gets on target fastest beats the sight that sees furthest.",
   "see": "hot-zone"
  },
  {
   "id": "enemy-beltfed",
   "label": "a belt-fed weapon",
   "when": {
    "group": "weapons",
    "field": "category",
    "matches": "lmg"
   },
   "weights": {
    "protection": 0.6,
    "smoke": 0.6
   },
   "because": "A weapon that never stops firing is one you cross ground against, not one you trade with in the open.",
